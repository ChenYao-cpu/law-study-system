.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.stats-card {
  background: linear-gradient(135deg, #DC143C, #FF6B6B);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.stat-row {
  display: flex;
  justify-content: space-around;
  margin-bottom: 30rpx;
}

.stat-row:last-child {
  margin-bottom: 0;
}

.stat-item {
  text-align: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  display: block;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 8rpx;
  display: block;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.progress-item {
  margin-bottom: 24rpx;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.course-name {
  font-size: 28rpx;
  color: #333;
}

.progress-percent {
  font-size: 26rpx;
  color: #DC143C;
  font-weight: bold;
}

.progress-bar {
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #DC143C, #FF6B6B);
  transition: width 0.3s;
}
