<view class="login-container">
  <view class="logo">
    <text class="logo-text">民族团结促进法</text>
    <text class="logo-subtitle">学习系统</text>
  </view>

  <view class="form">
    <view class="input-group">
      <input class="input" placeholder="请输入用户名" value="{{username}}" bindinput="onUsernameInput" />
    </view>

    <view class="input-group">
      <input class="input" type="password" placeholder="请输入密码" value="{{password}}" bindinput="onPasswordInput" />
    </view>

    <button class="submit-btn" bindtap="handleSubmit">
      {{isRegister ? '注册' : '登录'}}
    </button>

    <button class="wechat-btn" bindtap="handleWechatLogin">
      <text class="wechat-icon">💬</text>
      微信一键登录
    </button>

    <view class="toggle-text" bindtap="toggleMode">
      {{isRegister ? '已有账号？去登录' : '没有账号？去注册'}}
    </view>
  </view>
</view>
