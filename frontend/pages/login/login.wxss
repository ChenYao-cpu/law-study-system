.login-container {
  padding: 60rpx 40rpx;
  min-height: 100vh;
  background: linear-gradient(135deg, #DC143C, #FF6B6B);
}

.logo {
  text-align: center;
  margin: 100rpx 0 80rpx;
}

.logo-text {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  display: block;
}

.logo-subtitle {
  font-size: 32rpx;
  color: rgba(255,255,255,0.9);
  margin-top: 10rpx;
  display: block;
}

.form {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
}

.input-group {
  margin-bottom: 30rpx;
}

.input {
  height: 88rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

.submit-btn {
  background: #DC143C;
  color: #fff;
  border-radius: 12rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  margin: 40rpx 0 20rpx;
}

.wechat-btn {
  background: #07c160;
  color: #fff;
  border-radius: 12rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  margin: 20rpx 0;
}

.wechat-icon {
  margin-right: 10rpx;
}

.toggle-text {
  text-align: center;
  color: #DC143C;
  font-size: 26rpx;
  margin-top: 20rpx;
}
