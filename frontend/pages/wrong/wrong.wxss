.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.empty {
  text-align: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.wrong-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.wrong-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.wrong-type {
  font-size: 24rpx;
  color: #DC143C;
  background: #fff0f0;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.wrong-count {
  font-size: 24rpx;
  color: #ff4d4f;
}

.wrong-title {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.wrong-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.wrong-time {
  font-size: 22rpx;
  color: #999;
}

.remove-btn {
  font-size: 24rpx;
  color: #DC143C;
}
