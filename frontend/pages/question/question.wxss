.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.progress-bar {
  margin-bottom: 20rpx;
}

.progress-text {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 10rpx;
  display: block;
}

.progress-line {
  height: 8rpx;
  background: #e0e0e0;
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #DC143C;
  transition: width 0.3s;
}

.question-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
}

.question-type {
  font-size: 24rpx;
  color: #DC143C;
  background: #fff0f0;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  display: inline-block;
  margin-bottom: 20rpx;
}

.question-title {
  font-size: 32rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 30rpx;
}

.options {
  margin-bottom: 30rpx;
}

.option {
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
}

.option.selected {
  border-color: #DC143C;
  background: #fff0f0;
}

.option.correct {
  border-color: #52c41a;
  background: #f6ffed;
}

.option.wrong {
  border-color: #ff4d4f;
  background: #fff1f0;
}

.option-key {
  font-size: 28rpx;
  color: #666;
  margin-right: 16rpx;
  font-weight: bold;
}

.option-value {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.result {
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.result-text {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.result-text.correct {
  color: #52c41a;
}

.result-text.wrong {
  color: #ff4d4f;
}

.analysis {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.analysis-title {
  font-weight: bold;
  color: #333;
}

.submit-btn, .next-btn {
  background: #DC143C;
  color: #fff;
  border-radius: 12rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
}
