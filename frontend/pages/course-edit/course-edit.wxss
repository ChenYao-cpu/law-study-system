page { background: #F5F5F5; min-height: 100vh; }

.nav-header {
  background: linear-gradient(135deg, #DC2626 0%, #B91C1C 100%);
  width: 100%; height: 140rpx;
  display: flex; align-items: center; justify-content: space-between;
  padding: 50rpx 30rpx 0; box-sizing: border-box;
  position: fixed; top: 0; left: 0; z-index: 100;
}
.nav-left { display: flex; align-items: center; }
.nav-back { width: 80rpx; height: 80rpx; display: flex; align-items: center; justify-content: center; }
.back-icon { font-size: 48rpx; color: #FFF; font-weight: bold; }
.nav-title { display: flex; align-items: baseline; gap: 8rpx; }
.title-main { font-size: 40rpx; color: #FFF; font-weight: bold; }
.title-sub { font-size: 28rpx; color: #FFF; letter-spacing: 4rpx; }
.nav-right { width: 80rpx; }
/* 校徽翻转 */
.logo-flip-container { width: 80rpx; height: 80rpx; perspective: 1000rpx; }
.logo-card { width: 100%; height: 100%; position: relative; transform-style: preserve-3d; }
.flip-animation { animation: logoFlip 4s ease-in-out infinite; }
@keyframes logoFlip {
  0%,40% { transform: rotateY(0deg); }
  50%,90% { transform: rotateY(180deg); }
  100% { transform: rotateY(360deg); }
}
.logo-front, .logo-back {
  position: absolute; width: 100%; height: 100%;
  backface-visibility: hidden; border-radius: 50%; overflow: hidden;
  display: flex; align-items: center; justify-content: center;
}
.logo-front { background: #FFF; }
.logo-image { width: 90%; height: 90%; }
.logo-back {
  background: linear-gradient(135deg,#DC2626,#B91C1C);
  transform: rotateY(180deg); flex-direction: column; border: 2rpx solid #FFF;
}
.school-name, .school-name-university { font-size: 16rpx; color: #FFF; font-weight: bold; }

.form-container { padding: 170rpx 30rpx 40rpx; min-height: 100vh; }
.form-group { margin-bottom: 30rpx; }
.label { font-size: 28rpx; color: #333; font-weight: 500; display: block; margin-bottom: 12rpx; }
.required { color: #DC2626; }
.input {
  background: #FFF; border: 1rpx solid #E5E7EB; border-radius: 12rpx;
  padding: 20rpx; font-size: 28rpx; width: 100%; box-sizing: border-box;
}
.picker {
  background: #FFF; border: 1rpx solid #E5E7EB; border-radius: 12rpx;
  padding: 20rpx; font-size: 28rpx;
}
.textarea {
  background: #FFF; border: 1rpx solid #E5E7EB; border-radius: 12rpx;
  padding: 20rpx; font-size: 28rpx; width: 100%; min-height: 160rpx; box-sizing: border-box;
}
.form-row { display: flex; gap: 20rpx; }
.half { flex: 1; }

.btn-group { margin-top: 50rpx; display: flex; flex-direction: column; gap: 20rpx; padding-bottom: 40rpx; }
.btn { border: none; border-radius: 12rpx; padding: 28rpx; font-size: 30rpx; text-align: center; }
.btn-primary { background: linear-gradient(135deg, #DC2626, #B91C1C); color: #FFF; }
.btn-review { background: linear-gradient(135deg, #F59E0B, #D97706); color: #FFF; }
.btn-delete { background: #FFF; color: #DC2626; border: 1rpx solid #FCA5A5; }
