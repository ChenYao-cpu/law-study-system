.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.exam-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  padding: 20rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.timer {
  font-size: 32rpx;
  font-weight: bold;
  color: #DC143C;
}

.progress {
  font-size: 28rpx;
  color: #666;
}

.question-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.question-type {
  font-size: 24rpx;
  color: #DC143C;
  background: #fff0f0;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  display: inline-block;
  margin-bottom: 20rpx;
}

.question-title {
  font-size: 32rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 30rpx;
}

.options {
  margin-bottom: 30rpx;
}

.option {
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
}

.option.selected {
  border-color: #DC143C;
  background: #fff0f0;
}

.option-key {
  font-size: 28rpx;
  color: #666;
  margin-right: 16rpx;
  font-weight: bold;
}

.option-value {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.footer {
  display: flex;
  gap: 20rpx;
}

.nav-btn {
  flex: 1;
  background: #f0f0f0;
  color: #333;
  border-radius: 12rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
}

.nav-btn[disabled] {
  opacity: 0.5;
}

.submit-btn {
  flex: 1;
  background: #DC143C;
  color: #fff;
  border-radius: 12rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
}
