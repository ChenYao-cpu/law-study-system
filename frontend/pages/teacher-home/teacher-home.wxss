.teacher-container {
    min-height: 100vh;
    background: linear-gradient(180deg, #fff5f5 0%, #ffe6e6 100%);
    padding-bottom: 40rpx;
}

.custom-navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 120rpx;
    background: linear-gradient(135deg, #F03038 0%, #ED1C24 100%);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 0 30rpx 20rpx;
    z-index: 100;
    box-shadow: 0 4rpx 20rpx rgba(237, 28, 36, 0.3);
}

.navbar-left {
    width: 80rpx;
    height: 80rpx;
    display: flex;
    align-items: center;
    justify-content: center;
}


.home-icon {
    width: 72rpx;
    height: 72rpx;
    background: rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(10rpx);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2rpx solid rgba(255, 255, 255, 0.4);
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
    transition: all 0.3s;
}


.home-icon:active {
    transform: scale(0.9);
    background: rgba(255, 255, 255, 0.35);
}

/* ... existing code ... */

.icon-text {
    font-size: 36rpx;
    color: #F03038;
    filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.1));
}

/* ... existing code ... */


.navbar-title {
    color: #fff;
    font-size: 34rpx;
    font-weight: 600;
    flex: 1;
    text-align: center;
    padding-bottom: 8rpx;
}

.navbar-right {
    width: 80rpx;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8rpx;
    padding-bottom: 8rpx;
}

.nav-dot {
    width: 8rpx;
    height: 8rpx;
    background: rgba(255, 255, 255, 0.8);
    border-radius: 50%;
}

.nav-circle {
    width: 28rpx;
    height: 28rpx;
    border: 2rpx solid rgba(255, 255, 255, 0.8);
    border-radius: 50%;
    margin-left: 4rpx;
}

.page-header {
    margin-top: 120rpx;
    background: linear-gradient(135deg, #F03038 0%, #ED1C24 50%, #D8171E 100%);
    padding: 60rpx 40rpx 80rpx;
    position: relative;
    overflow: hidden;
}

.page-header::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 400rpx;
    height: 400rpx;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.15) 0%, transparent 70%);
    border-radius: 50%;
}

.page-header::after {
    content: '';
    position: absolute;
    bottom: -30%;
    left: -10%;
    width: 300rpx;
    height: 300rpx;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 0%, transparent 70%);
    border-radius: 50%;
}

.page-title {
    display: block;
    color: #fff;
    font-size: 44rpx;
    font-weight: bold;
    margin-bottom: 16rpx;
    position: relative;
    z-index: 1;
    text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.page-date {
    display: block;
    color: rgba(255, 255, 255, 0.9);
    font-size: 26rpx;
    position: relative;
    z-index: 1;
}

.card-list {
    padding: 0 30rpx;
    margin-top: -40rpx;
    position: relative;
    z-index: 2;
}

.function-card {
    background: #fff;
    border-radius: 24rpx;
    padding: 32rpx;
    margin-bottom: 24rpx;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: 0 8rpx 24rpx rgba(237, 28, 36, 0.12);
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
    border: 1rpx solid rgba(240, 48, 56, 0.1);
}

.function-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(240, 48, 56, 0.05) 0%, rgba(237, 28, 36, 0.05) 100%);
    opacity: 0;
    transition: opacity 0.3s;
}

.function-card:active::before {
    opacity: 1;
}

.function-card:active {
    transform: scale(0.98);
    box-shadow: 0 4rpx 16rpx rgba(237, 28, 36, 0.2);
}

.card-header {
    display: flex;
    align-items: center;
    flex: 1;
}

.card-badge {
    width: 8rpx;
    height: 60rpx;
    border-radius: 4rpx;
    margin-right: 24rpx;
    flex-shrink: 0;
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.card-info {
    display: flex;
    flex-direction: column;
}

.card-title {
    font-size: 32rpx;
    color: #2d3748;
    font-weight: 600;
    margin-bottom: 8rpx;
}

.card-desc {
    font-size: 24rpx;
    color: #a0aec0;
}

.card-arrow {
    font-size: 48rpx;
    color: #F03038;
    font-weight: 300;
    line-height: 1;
    margin-left: 20rpx;
    opacity: 0.6;
}

/* 切换到党员端横幅 */
.switch-banner {
    background: linear-gradient(135deg, #fff5f5 0%, #fff 100%);
    border: 2rpx solid #F03038;
    border-radius: 24rpx;
    padding: 28rpx 32rpx;
    margin-bottom: 24rpx;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: 0 4rpx 16rpx rgba(237, 28, 36, 0.08);
    transition: all 0.3s ease;
}

.switch-banner:active {
    transform: scale(0.98);
    background: linear-gradient(135deg, #ffe6e6 0%, #fff5f5 100%);
    box-shadow: 0 6rpx 20rpx rgba(237, 28, 36, 0.15);
}

.switch-banner-left {
    display: flex;
    align-items: center;
    gap: 20rpx;
}

.switch-icon {
    font-size: 44rpx;
    color: #F03038;
}

.switch-info {
    display: flex;
    flex-direction: column;
}

.switch-title {
    font-size: 30rpx;
    color: #F03038;
    font-weight: 600;
    margin-bottom: 4rpx;
}

.switch-desc {
    font-size: 22rpx;
    color: #a0aec0;
}

.switch-arrow {
    font-size: 48rpx;
    color: #F03038;
    font-weight: 300;
    opacity: 0.6;
}
