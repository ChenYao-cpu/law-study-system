<view class="teacher-container">
    <view class="custom-navbar">
        <view class="navbar-left" bindtap="goBack">
            <view class="home-icon">
                <text class="iconfont icon-danghui icon-text"></text>
            </view>
        </view>
        <view class="navbar-title">管理者工作台</view>
        <view class="navbar-right">
            <view class="nav-dot"></view>
            <view class="nav-dot"></view>
            <view class="nav-dot"></view>
            <view class="nav-circle"></view>
        </view>
    </view>

    <view class="page-header">
        <text class="page-title">管理者工作台</text>
        <text class="page-date">{{currentDate}}</text>
    </view>

    <view class="card-list">
        <!-- 切换到党员学习端 -->
        <view class="switch-banner" bindtap="switchToParty">
            <view class="switch-banner-left">
                <text class="iconfont icon-danghui switch-icon"></text>
                <view class="switch-info">
                    <text class="switch-title">切换到党员学习端</text>
                    <text class="switch-desc">管理员也是党员，点击进入学习做题</text>
                </view>
            </view>
            <text class="switch-arrow">›</text>
        </view>

        <view class="function-card" bindtap="goPage" data-url="/pages/assignment-manage/assignment-manage">
            <view class="card-header">
                <view class="card-badge" style="background: linear-gradient(135deg, #ff6b6b 0%, #ee5a6f 100%);"></view>
                <view class="card-info">
                    <text class="card-title">作业管理</text>
                    <text class="card-desc">创建编辑与提交审核</text>
                </view>
            </view>
            <view class="card-arrow">›</view>
        </view>

        <view class="function-card" bindtap="goPage" data-url="/pages/assignment-publish/assignment-publish">
            <view class="card-header">
                <view class="card-badge" style="background: linear-gradient(135deg, #ff9a76 0%, #fe8a71 100%);"></view>
                <view class="card-info">
                    <text class="card-title">布置作业</text>
                    <text class="card-desc">从题库随机抽取生成</text>
                </view>
            </view>
            <view class="card-arrow">›</view>
        </view>

        <view class="function-card" bindtap="goPage" data-url="/pages/student-progress/student-progress">
            <view class="card-header">
                <view class="card-badge" style="background: linear-gradient(135deg, #ff6b9d 0%, #ffa8c5 100%);"></view>
                <view class="card-info">
                    <text class="card-title">学习进度</text>
                    <text class="card-desc">查看各党员练习情况</text>
                </view>
            </view>
            <view class="card-arrow">›</view>
        </view>

        <view class="function-card" bindtap="goPage" data-url="/pages/assignment-statistics/assignment-statistics">
            <view class="card-header">
                <view class="card-badge" style="background: linear-gradient(135deg, #ff8a80 0%, #ff5252 100%);"></view>
                <view class="card-info">
                    <text class="card-title">成绩统计</text>
                    <text class="card-desc">图表分析与进步情况</text>
                </view>
            </view>
            <view class="card-arrow">›</view>
        </view>

        <view class="function-card" bindtap="goPage" data-url="/pages/course-manage/course-manage">
            <view class="card-header">
                <view class="card-badge" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);"></view>
                <view class="card-info">
                    <text class="card-title">课程管理</text>
                    <text class="card-desc">上传视频、提交法务审核</text>
                </view>
            </view>
            <view class="card-arrow">›</view>
        </view>
    </view>
</view>
