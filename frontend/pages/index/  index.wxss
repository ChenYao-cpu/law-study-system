.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.header {
  padding: 20rpx 0;
}

.welcome {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.date {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.stats-card {
  display: flex;
  justify-content: space-around;
  background: linear-gradient(135deg, #DC143C, #FF6B6B);
  border-radius: 16rpx;
  padding: 30rpx;
  margin: 20rpx 0;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
  margin-top: 8rpx;
}

.quick-actions {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  margin: 20rpx 0;
}

.action-btn {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.action-icon {
  font-size: 48rpx;
  margin-bottom: 10rpx;
}

.action-text {
  font-size: 24rpx;
  color: #333;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin: 20rpx 0;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.section-more {
  font-size: 24rpx;
  color: #999;
}

.notice-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.notice-title {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.notice-time {
  font-size: 22rpx;
  color: #999;
}

.course-list {
  display: flex;
  overflow-x: auto;
  gap: 20rpx;
}

.course-item {
  min-width: 240rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.course-cover {
  width: 240rpx;
  height: 160rpx;
}

.course-info {
  padding: 10rpx;
}

.course-title {
  font-size: 26rpx;
  color: #333;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-duration {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
}

