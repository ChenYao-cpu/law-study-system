<view class="container">
  <view class="header">
    <view class="welcome">你好，{{userInfo.nickname}}</view>
    <view class="date">{{today}}</view>
  </view>

  <view class="stats-card">
    <view class="stat-item">
      <text class="stat-value">{{studyOverview.totalDuration || 0}}</text>
      <text class="stat-label">学习时长(分钟)</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">{{studyOverview.totalScore || 0}}</text>
      <text class="stat-label">总积分</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">{{studyOverview.studyDays || 0}}</text>
      <text class="stat-label">学习天数</text>
    </view>
  </view>

  <view class="quick-actions">
    <view class="action-btn" bindtap="goToQuestion">
      <text class="action-icon">📝</text>
      <text class="action-text">开始刷题</text>
    </view>
    <view class="action-btn" bindtap="goToExam">
      <text class="action-icon">📋</text>
      <text class="action-text">模拟考试</text>
    </view>
    <view class="action-btn" bindtap="goToWrong">
      <text class="action-icon">❌</text>
      <text class="action-text">错题本</text>
    </view>
    <view class="action-btn" bindtap="goToStudy">
      <text class="action-icon">📊</text>
      <text class="action-text">学习记录</text>
    </view>
    <view class="action-btn" bindtap="goToNote">
      <text class="action-icon">📒</text>
      <text class="action-text">我的笔记</text>
    </view>
    <view class="action-btn" bindtap="goToAI">
      <text class="action-icon">🤖</text>
      <text class="action-text">AI助手</text>
    </view>
  </view>

  <view class="section" wx:if="{{notices.length > 0}}">
    <view class="section-header">
      <text class="section-title">最新公告</text>
      <text class="section-more" bindtap="goToNotice">更多 ></text>
    </view>
    <view class="notice-list">
      <view class="notice-item" wx:for="{{notices}}" wx:key="id" bindtap="goToNotice">
        <text class="notice-title">{{item.title}}</text>
        <text class="notice-time">{{item.publishTime}}</text>
      </view>
    </view>
  </view>

  <view class="section" wx:if="{{recommendCourses.length > 0}}">
    <view class="section-header">
      <text class="section-title">推荐课程</text>
    </view>
    <view class="course-list">
      <view class="course-item" wx:for="{{recommendCourses}}" wx:key="id"
            bindtap="goToCourse" data-id="{{item.id}}">
        <image class="course-cover" src="{{item.cover}}" mode="aspectFill"></image>
        <view class="course-info">
          <text class="course-title">{{item.title}}</text>
          <text class="course-duration">{{item.duration}}分钟</text>
        </view>
      </view>
    </view>
  </view>
</view>
