<view class="container">
  <view wx:if="{{currentCourse}}">
    <video class="video" src="{{currentCourse.videoUrl}}" controls></video>

    <view class="course-detail">
      <view class="course-title">{{currentCourse.title}}</view>
      <view class="course-meta">
        <text class="duration">⏱ {{currentCourse.duration}}分钟</text>
      </view>
      <view class="course-desc">{{currentCourse.description}}</view>
      <view class="course-content">{{currentCourse.content}}</view>

      <button class="record-btn" bindtap="recordStudy">记录学习</button>
    </view>
  </view>

  <view wx:else class="course-list">
    <view class="course-item" wx:for="{{courses}}" wx:key="id">
      <image class="course-cover" src="{{item.cover}}" mode="aspectFill"></image>
      <view class="course-info">
        <text class="course-title">{{item.title}}</text>
        <text class="course-desc">{{item.description}}</text>
        <view class="course-footer">
          <text class="duration">{{item.duration}}分钟</text>
        </view>
      </view>
    </view>

    <view class="loading" wx:if="{{hasMore}}">加载中...</view>
    <view class="no-more" wx:else>没有更多了</view>
  </view>
</view>
