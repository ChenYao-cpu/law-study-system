<view class="ai-container">
  <view class="header">
    <text class="title">AI助教</text>
    <text class="subtitle">民族团结促进法智能问答</text>
  </view>

  <scroll-view class="chat-area" scroll-y scroll-into-view="msg-{{messages.length}}">
    <view class="welcome" wx:if="{{messages.length === 0}}">
      <text class="welcome-icon">🤖</text>
      <text class="welcome-text">你好！我是AI助教，关于民族团结促进法的问题都可以问我哦~</text>
    </view>

    <view class="message-item" wx:for="{{messages}}" wx:key="index" id="msg-{{index}}">
      <view class="message-wrapper {{item.role === 'user' ? 'user-msg' : 'ai-msg'}}">
        <text class="message-text">{{item.content}}</text>
      </view>
    </view>

    <view class="loading" wx:if="{{loading}}">
      <text>AI思考中...</text>
    </view>
  </scroll-view>

  <view class="input-area">
    <input
      class="input-box"
      placeholder="输入你的问题..."
      value="{{inputText}}"
      bindinput="onInput"
      confirm-type="send"
      bindconfirm="sendQuestion"
    />
    <button class="send-btn" bindtap="sendQuestion" disabled="{{loading}}">发送</button>
  </view>
</view>
