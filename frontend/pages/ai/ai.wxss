.ai-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #FFF8DC, #F5DEB3);
}

.header {
  background: linear-gradient(135deg, #DC143C, #8B0000);
  padding: 30rpx;
  text-align: center;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #FFD700;
  display: block;
}

.subtitle {
  font-size: 24rpx;
  color: #FFF;
  margin-top: 10rpx;
  display: block;
}

.chat-area {
  flex: 1;
  padding: 20rpx;
}

.welcome {
  text-align: center;
  padding: 100rpx 40rpx;
}

.welcome-icon {
  font-size: 120rpx;
  display: block;
  margin-bottom: 30rpx;
}

.welcome-text {
  font-size: 28rpx;
  color: #8B4513;
}

.message-item {
  margin-bottom: 30rpx;
}

.message-wrapper {
  max-width: 80%;
  padding: 20rpx 30rpx;
  border-radius: 20rpx;
  word-wrap: break-word;
}

.user-msg {
  background: #DC143C;
  margin-left: auto;
  border-bottom-right-radius: 5rpx;
}

.user-msg .message-text {
  color: #FFF;
}

.ai-msg {
  background: #FFF;
  border: 2rpx solid #8B4513;
  border-bottom-left-radius: 5rpx;
}

.ai-msg .message-text {
  color: #333;
}

.message-text {
  font-size: 28rpx;
  line-height: 1.6;
}

.loading {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  padding: 20rpx;
}

.input-area {
  display: flex;
  padding: 20rpx;
  background: #FFF;
  border-top: 2rpx solid #DDD;
}

.input-box {
  flex: 1;
  height: 80rpx;
  background: #F5F5F5;
  border-radius: 40rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
}

.send-btn {
  width: 150rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: #DC143C;
  color: #FFD700;
  border-radius: 40rpx;
  margin-left: 20rpx;
  font-size: 28rpx;
}

.send-btn[disabled] {
  background: #CCC;
  color: #999;
}
