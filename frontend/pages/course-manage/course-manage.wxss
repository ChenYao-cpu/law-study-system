page { background: #F5F5F5; min-height: 100vh; }

.nav-header {
  background: linear-gradient(135deg, #DC2626 0%, #B91C1C 100%);
  width: 100%; height: 140rpx;
  display: flex; align-items: center; justify-content: space-between;
  padding: 50rpx 30rpx 0; box-sizing: border-box;
  position: fixed; top: 0; left: 0; z-index: 100;
}
.nav-left { display: flex; align-items: center; }
.nav-back { width: 80rpx; height: 80rpx; display: flex; align-items: center; justify-content: center; }
.back-icon { font-size: 48rpx; color: #FFF; font-weight: bold; }
.nav-title { display: flex; align-items: baseline; gap: 8rpx; }
.title-main { font-size: 40rpx; color: #FFF; font-weight: bold; }
.title-sub { font-size: 28rpx; color: #FFF; letter-spacing: 4rpx; }
.nav-right { width: 80rpx; }
.logo-flip-container { width: 80rpx; height: 80rpx; perspective: 1000rpx; }
.logo-card { width: 100%; height: 100%; position: relative; transform-style: preserve-3d; }
.flip-animation { animation: logoFlip 4s ease-in-out infinite; }
@keyframes logoFlip {
  0%,40% { transform: rotateY(0deg); }
  50%,90% { transform: rotateY(180deg); }
  100% { transform: rotateY(360deg); }
}
.logo-front, .logo-back {
  position: absolute; width: 100%; height: 100%;
  backface-visibility: hidden; border-radius: 50%; overflow: hidden;
  display: flex; align-items: center; justify-content: center;
}
.logo-front { background: #FFF; }
.logo-image { width: 90%; height: 90%; }
.logo-back {
  background: linear-gradient(135deg,#DC2626,#B91C1C);
  transform: rotateY(180deg); flex-direction: column; border: 2rpx solid #FFF;
}
.school-name, .school-name-university { font-size: 16rpx; color: #FFF; font-weight: bold; }

.container { padding: 170rpx 30rpx 40rpx; }

.header-bar {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 30rpx;
}
.header-title { font-size: 32rpx; font-weight: bold; color: #333; }
.btn-create {
  background: linear-gradient(135deg, #DC2626, #B91C1C);
  color: #FFF; border: none; border-radius: 8rpx;
  padding: 16rpx 30rpx; font-size: 26rpx;
}

.course-card {
  background: #FFF; border-radius: 16rpx; padding: 24rpx;
  margin-bottom: 20rpx; display: flex; align-items: center;
}
.course-cover {
  width: 120rpx; height: 80rpx; border-radius: 10rpx;
  background-size: cover; background-position: center;
  position: relative; flex-shrink: 0; margin-right: 20rpx;
  background-color: #E5E7EB;
}
.course-status {
  position: absolute; top: 6rpx; right: 6rpx;
  font-size: 20rpx; color: #FFF; padding: 2rpx 10rpx;
  border-radius: 6rpx;
}
.course-info { flex: 1; }
.course-title { font-size: 28rpx; font-weight: bold; color: #333; display: block; margin-bottom: 6rpx; }
.course-meta { font-size: 22rpx; color: #999; }
.course-actions { display: flex; gap: 10rpx; flex-shrink: 0; }
.btn-sm {
  font-size: 22rpx; padding: 10rpx 20rpx; border-radius: 6rpx;
  border: 1rpx solid #E5E7EB; background: #F9FAFB; color: #333;
}
.btn-review { background: #FEF3C7; border-color: #F59E0B; color: #D97706; }
.btn-publish { background: #D1FAE5; border-color: #10B981; color: #059669; }
.empty-tip { text-align: center; color: #999; padding: 100rpx 0; }
