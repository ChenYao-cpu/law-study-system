<view class="page">
  <view class="container">
    <!-- 新建按钮 -->
    <view class="header-bar">
      <text class="header-title">我的课程（{{courses.length}}个）</text>
      <button class="btn-create" bindtap="goCreate">+ 新建课程</button>
    </view>

    <!-- Loading -->
    <view class="loading" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>

    <!-- 课程列表 -->
    <view class="course-list" wx:else>
      <view class="empty-tip" wx:if="{{courses.length === 0}}">
        <text>暂无课程，点击上方按钮创建</text>
      </view>

      <view class="course-card" wx:for="{{courses}}" wx:key="id">
        <view class="course-cover" style="background-image:url({{item.cover || '/images/default-cover.png'}})">
          <view class="course-status" style="background:{{statusColor[item.reviewStatus] || '#9CA3AF'}}">
            {{statusMap[item.reviewStatus] || '草稿'}}
          </view>
        </view>
        <view class="course-info">
          <text class="course-title">{{item.title}}</text>
          <text class="course-meta">{{item.category}} · {{item.duration}}分钟 · {{item.points}}积分</text>
        </view>
        <view class="course-actions">
          <button class="btn-sm" bindtap="goEdit" data-id="{{item.id}}">编辑</button>
          <button class="btn-sm btn-review" wx:if="{{item.reviewStatus === 'draft' || item.reviewStatus === 'rejected'}}" bindtap="submitForReview" data-id="{{item.id}}">送审</button>
          <button class="btn-sm btn-publish" wx:if="{{item.reviewStatus === 'approved'}}" bindtap="publishCourse" data-id="{{item.id}}">发布</button>
        </view>
      </view>
    </view>
  </view>
</view>
