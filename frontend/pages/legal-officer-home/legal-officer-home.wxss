.teacher-container {
    min-height: 100vh;
    background: linear-gradient(180deg, #fff5f5 0%, #ffe6e6 100%);
    padding-bottom: 40rpx;
}

.custom-navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 120rpx;
    background: linear-gradient(135deg, #F03038 0%, #ED1C24 100%);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 0 30rpx 20rpx;
    z-index: 100;
    box-shadow: 0 4rpx 20rpx rgba(237, 28, 36, 0.3);
}

.navbar-left {
    width: 80rpx;
    height: 80rpx;
    display: flex;
    align-items: center;
    justify-content: center;
}

.home-icon {
    width: 72rpx;
    height: 72rpx;
    background: rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(10rpx);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2rpx solid rgba(255, 255, 255, 0.4);
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
    transition: all 0.3s;
}

.home-icon:active {
    transform: scale(0.9);
    background: rgba(255, 255, 255, 0.35);
}

.icon-text {
    font-size: 36rpx;
    color: #F03038;
    filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.1));
}

.navbar-title {
    color: #fff;
    font-size: 34rpx;
    font-weight: 600;
    flex: 1;
    text-align: center;
    padding-bottom: 8rpx;
}

.navbar-right {
    width: 80rpx;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8rpx;
    padding-bottom: 8rpx;
}

.nav-dot {
    width: 8rpx;
    height: 8rpx;
    background: rgba(255, 255, 255, 0.8);
    border-radius: 50%;
}

.nav-circle {
    width: 28rpx;
    height: 28rpx;
    border: 2rpx solid rgba(255, 255, 255, 0.8);
    border-radius: 50%;
    margin-left: 4rpx;
}

.page-header {
    margin-top: 120rpx;
    background: linear-gradient(135deg, #F03038 0%, #ED1C24 50%, #D8171E 100%);
    padding: 60rpx 40rpx 80rpx;
    position: relative;
    overflow: hidden;
}

.page-header::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 400rpx;
    height: 400rpx;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.15) 0%, transparent 70%);
    border-radius: 50%;
}

.page-header::after {
    content: '';
    position: absolute;
    bottom: -30%;
    left: -10%;
    width: 300rpx;
    height: 300rpx;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 0%, transparent 70%);
    border-radius: 50%;
}

.page-title {
    display: block;
    color: #fff;
    font-size: 44rpx;
    font-weight: bold;
    margin-bottom: 16rpx;
    position: relative;
    z-index: 1;
    text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.page-date {
    display: block;
    color: rgba(255, 255, 255, 0.9);
    font-size: 26rpx;
    position: relative;
    z-index: 1;
}

.card-list {
    padding: 0 30rpx;
    margin-top: -40rpx;
    position: relative;
    z-index: 2;
}

/* 审核标签切换 */
.review-tabs {
    display: flex;
    background: #fff;
    border-radius: 20rpx;
    padding: 8rpx;
    margin-bottom: 24rpx;
    box-shadow: 0 4rpx 16rpx rgba(237, 28, 36, 0.1);
}

.review-tab {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 80rpx;
    border-radius: 16rpx;
    font-size: 28rpx;
    color: #666;
    gap: 10rpx;
    transition: all 0.3s;
}

.review-tab.active {
    background: linear-gradient(135deg, #F03038, #ED1C24);
    color: #fff;
    font-weight: bold;
    box-shadow: 0 4rpx 12rpx rgba(237, 28, 36, 0.3);
}

.tab-badge {
    background: #ff4d4f;
    color: #fff;
    font-size: 22rpx;
    padding: 4rpx 12rpx;
    border-radius: 20rpx;
    min-width: 36rpx;
    text-align: center;
}

/* 审核卡片 */
.review-list {
    display: flex;
    flex-direction: column;
    gap: 20rpx;
}

.review-card {
    background: #fff;
    border-radius: 24rpx;
    padding: 32rpx;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: 0 8rpx 24rpx rgba(237, 28, 36, 0.12);
    transition: all 0.3s ease;
    border: 1rpx solid rgba(240, 48, 56, 0.1);
}

.review-card:active {
    transform: scale(0.98);
    box-shadow: 0 4rpx 16rpx rgba(237, 28, 36, 0.2);
}

.card-header {
    display: flex;
    align-items: center;
    flex: 1;
}

.card-badge {
    width: 8rpx;
    height: 60rpx;
    border-radius: 4rpx;
    margin-right: 24rpx;
    flex-shrink: 0;
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.card-info {
    display: flex;
    flex-direction: column;
}

.card-title {
    font-size: 32rpx;
    color: #2d3748;
    font-weight: 600;
    margin-bottom: 8rpx;
}

.card-desc {
    font-size: 24rpx;
    color: #a0aec0;
}

.card-status {
    font-size: 24rpx;
    padding: 10rpx 24rpx;
    border-radius: 30rpx;
    font-weight: 600;
    flex-shrink: 0;
    margin-left: 16rpx;
}

.card-status.pending {
    background: #fff7e6;
    color: #fa8c16;
}

.card-status.approved {
    background: #f6ffed;
    color: #52c41a;
}

.card-status.rejected {
    background: #fff2f0;
    color: #ff4d4f;
}

.empty-state {
    text-align: center;
    padding: 80rpx 0;
}

.empty-icon {
    font-size: 80rpx;
    display: block;
    margin-bottom: 16rpx;
}

.empty-text {
    font-size: 28rpx;
    color: #a0aec0;
}
