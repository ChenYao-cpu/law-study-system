@import '../styles/iconfont.wxss';
.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: white;
  display: flex;
  border-top: 1rpx solid #eee;
}
.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.tab-bar-item .iconfont {
  font-size: 48rpx;
  color: #999;
  margin-bottom: 8rpx;
}
.tab-bar-item .iconfont.active { color: #ff4d4f; }
.tab-text { font-size: 24rpx; color: #999; }
.tab-bar-item.active .tab-text { color: #ff4d4f; }
